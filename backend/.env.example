# ─── Wajib ───
# JWT Secret untuk otentikasi (min 32 karakter)
JWT_SECRET=changeme_min32char_jwt_secret_key_here

# ─── Opsional ───
# Backend port (default: 3001)
PORT=3001

# PostgreSQL connection string (optional - falls back to in-memory)
# DATABASE_URL=postgres://user:password@host:5432/dinodash

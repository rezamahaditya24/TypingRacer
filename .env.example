# ─── Wajib ───
# Ganti dengan password PostgreSQL yang kuat
POSTGRES_PASSWORD=changeme_strong_password

# Ganti dengan secret key JWT yang kuat (min 32 karakter, gunakan random string)
JWT_SECRET=changeme_min32char_jwt_secret_key_here

# ─── Opsional ───
# Backend port (default: 3001)
BACKEND_PORT=3001

# Frontend port (default: 3000)
FRONTEND_PORT=3000

# Database port (default: 5432)
DB_PORT=5432

# PostgreSQL connection string (digunakan otomatis dari vars di atas)
# DATABASE_URL=postgres://user:password@host:5432/dinodash

# WebSocket URL untuk frontend (default untuk docker compose)
NEXT_PUBLIC_WS_HOST=ws://localhost:3001

# Environment mode
NODE_ENV=development
